{
  "name": "@openproject/commonmark-ckeditor-build",
  "version": "11.1.1",
  "description": "CKEditor 5 editor build with CommonMark and plugins for OpenProject.",
  "keywords": [
    "ckeditor5",
    "ckeditor5-build",
    "text editor",
    "WYSIWYG",
    "rich-text editor"
  ],
  "type": "module",
  "main": "./dist/ckeditor.js",
  "types": "./dist/ckeditor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ckeditor.d.ts",
      "default": "./dist/ckeditor.js"
    },
    "./ckeditor.css": "./dist/ckeditor.css",
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "default": "./dist/translations/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "CKSource Frederico Knabben (http://cksource.com/)",
    "OpenProject GmbH"
  ],
  "license": "(GPL-2.0-or-later OR LGPL-2.1-or-later OR MPL-1.1+)",
  "homepage": "https://github.com/opf/commonmark-ckeditor-build#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opf/commonmark-ckeditor-build.git"
  },
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production node bin/build.mjs && node ./bin/build-ckeditor-translations.mjs && node ./bin/build-ckeditor-styles.mjs && node bin/mirror-to-core.mjs",
    "watch": "node bin/build.mjs --watch",
    "prepare": "patch-package",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run verify:build && npm run verify:package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest .",
    "test:bin": "node --test \"bin/**/*.test.mjs\"",
    "verify:build": "node bin/verify-build.mjs dist",
    "verify:package": "node bin/verify-package.mjs && publint"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ckeditor/ckeditor5-adapter-ckfinder": "48.0.0",
    "@ckeditor/ckeditor5-autoformat": "48.0.0",
    "@ckeditor/ckeditor5-autosave": "48.0.0",
    "@ckeditor/ckeditor5-basic-styles": "48.0.0",
    "@ckeditor/ckeditor5-block-quote": "48.0.0",
    "@ckeditor/ckeditor5-ckfinder": "48.0.0",
    "@ckeditor/ckeditor5-core": "48.0.0",
    "@ckeditor/ckeditor5-easy-image": "48.0.0",
    "@ckeditor/ckeditor5-editor-classic": "48.0.0",
    "@ckeditor/ckeditor5-editor-decoupled": "48.0.0",
    "@ckeditor/ckeditor5-engine": "48.0.0",
    "@ckeditor/ckeditor5-enter": "48.0.0",
    "@ckeditor/ckeditor5-essentials": "48.0.0",
    "@ckeditor/ckeditor5-heading": "48.0.0",
    "@ckeditor/ckeditor5-image": "48.0.0",
    "@ckeditor/ckeditor5-link": "48.0.0",
    "@ckeditor/ckeditor5-list": "48.0.0",
    "@ckeditor/ckeditor5-media-embed": "48.0.0",
    "@ckeditor/ckeditor5-mention": "48.0.0",
    "@ckeditor/ckeditor5-page-break": "48.0.0",
    "@ckeditor/ckeditor5-paragraph": "48.0.0",
    "@ckeditor/ckeditor5-paste-from-office": "48.0.0",
    "@ckeditor/ckeditor5-remove-format": "48.0.0",
    "@ckeditor/ckeditor5-table": "48.0.0",
    "@ckeditor/ckeditor5-typing": "48.0.0",
    "@ckeditor/ckeditor5-ui": "48.0.0",
    "@ckeditor/ckeditor5-undo": "48.0.0",
    "@ckeditor/ckeditor5-upload": "48.0.0",
    "@ckeditor/ckeditor5-utils": "48.0.0",
    "@ckeditor/ckeditor5-watchdog": "48.0.0",
    "@ckeditor/ckeditor5-widget": "48.0.0",
    "@eslint/js": "^9.16.0",
    "@rails/request.js": "^0.0.13",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/turndown": "^5.0.6",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.23.0",
    "eslint-plugin-jest": "^28.9.0",
    "globals": "^15.9.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lz-string": "^1.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "patch-package": "^8.0.1",
    "publint": "^0.3.25",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
